# Dockerfile.backend
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    tar \
    && rm -rf /var/lib/apt/lists/*

# Download Bumblebee binary.
#
# The tag and the tarball's sha256 are both pinned. This downloads a scanner
# that will then run against the filesystem, so the artifact is verified before
# it is ever executed. The digest is the one published in the release's own
# asset metadata (and repeated in its checksums.txt); curl -f so an error page
# can never be saved in place of the tarball.
ARG BUMBLEBEE_VERSION=0.1.2
ARG BUMBLEBEE_SHA256=53b080cf3ddb692b0c4e5492ef4785b4c54daf1624fcd0fcba3958116a0be8d9
RUN curl -fsSL "https://github.com/perplexityai/bumblebee/releases/download/v${BUMBLEBEE_VERSION}/bumblebee_${BUMBLEBEE_VERSION}_linux_amd64.tar.gz" \
    -o /tmp/bumblebee.tar.gz \
    && echo "${BUMBLEBEE_SHA256}  /tmp/bumblebee.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/bumblebee.tar.gz -C /usr/local/bin/ \
    && rm /tmp/bumblebee.tar.gz \
    && chmod +x /usr/local/bin/bumblebee

# Exposure catalogues.
#
# A scan reports nothing unless the scanner has something to compare packages
# against, so the image carries upstream's threat-intel set. The commit is
# pinned and every file's sha256 is listed in threat-intel.manifest, because
# this data decides what gets reported as malicious: it is fetched at build
# time rather than at run time, and verified before it is installed. It lives
# outside /app, which the compose setup bind-mounts over during development.
ARG BUMBLEBEE_THREAT_INTEL_COMMIT=cc57710eeaf685e7b89924a36c8583cad0a378fe
COPY threat-intel.manifest /tmp/threat-intel.manifest
RUN mkdir -p /opt/bumblebee/threat-intel \
    && cd /tmp \
    && while read -r digest name; do \
         curl -fsSL "https://raw.githubusercontent.com/perplexityai/bumblebee/${BUMBLEBEE_THREAT_INTEL_COMMIT}/threat_intel/${name}" -o "/tmp/${name}"; \
       done < /tmp/threat-intel.manifest \
    && sha256sum -c --strict /tmp/threat-intel.manifest \
    && cp /tmp/*.json /opt/bumblebee/threat-intel/ \
    && rm -f /tmp/*.json /tmp/threat-intel.manifest

# Verify installation
RUN bumblebee version

# Install Python dependencies
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY backend/ .

# Create data directory
RUN mkdir -p /root/.bumblebee-gui/scans

EXPOSE 8000

CMD ["uvicorn", "bumblebee_gui.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
