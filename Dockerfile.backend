# Dockerfile.backend

# The scanner CLI, built from a pinned upstream commit.
#
# Upstream has published no release since v0.1.2 (2026-06-18), while the
# catalogues it maintains moved to schema 0.2.0, which v0.1.2 refuses to load.
# Building from a commit is the only way to ship a scanner that can read them.
# The commit is asserted after checkout and git resolves a tree by content, so
# the source is verified before it is compiled.
FROM golang:1.26-bookworm@sha256:dc40a13b61304647ed7e5d581d246b86413dfc29d63c6d018310feb93cd98fc0 AS scanner

ARG BUMBLEBEE_COMMIT=c1e83c0adb53a7f527b40a7181a690ad99a0a6e0

RUN git clone --quiet https://github.com/perplexityai/bumblebee /src \
    && cd /src \
    && git checkout --quiet --detach "${BUMBLEBEE_COMMIT}" \
    && test "$(git rev-parse HEAD)" = "${BUMBLEBEE_COMMIT}" \
    && CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /out/bumblebee ./cmd/bumblebee

FROM python:3.11-slim@sha256:07d4824036af339fa1b6ef769cc99d9c10a141769538b52b3b597c84f7a7b535

WORKDIR /app

# Install system dependencies (curl fetches the catalogues below)
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# The binary built above. It runs against the filesystem, so the image proves it
# starts before anything else is layered on top.
COPY --from=scanner /out/bumblebee /usr/local/bin/bumblebee
RUN chmod +x /usr/local/bin/bumblebee && bumblebee version

# Exposure catalogues.
#
# A scan reports nothing unless the scanner has something to compare packages
# against, so the image carries upstream's threat-intel set. The commit is
# pinned and every file's sha256 is listed in threat-intel.manifest, because
# this data decides what gets reported as malicious: it is fetched at build
# time rather than at run time, and verified before it is installed. It lives
# outside /app, which the compose setup bind-mounts over during development.
ARG BUMBLEBEE_THREAT_INTEL_COMMIT=c1e83c0adb53a7f527b40a7181a690ad99a0a6e0
COPY threat-intel.manifest /tmp/threat-intel.manifest
RUN mkdir -p /opt/bumblebee/threat-intel \
    && cd /tmp \
    && while read -r digest name; do \
         curl -fsSL "https://raw.githubusercontent.com/perplexityai/bumblebee/${BUMBLEBEE_THREAT_INTEL_COMMIT}/threat_intel/${name}" -o "/tmp/${name}"; \
       done < /tmp/threat-intel.manifest \
    && sha256sum -c --strict /tmp/threat-intel.manifest \
    && cp /tmp/*.json /opt/bumblebee/threat-intel/ \
    && rm -f /tmp/*.json /tmp/threat-intel.manifest

# Install Python dependencies
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY backend/ .

# Create data directory
RUN mkdir -p /root/.bumblebee-gui/scans

EXPOSE 8000

CMD ["uvicorn", "bumblebee_gui.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
